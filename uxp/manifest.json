{
  "manifestVersion": 6,
  "id": "us.theatr.layer-math",
  "name": "Layer Math",
  "version": "0.1.0",
  "main": "index.html",
  "host": { "app": "PS", "minVersion": "25.0.0", "data": { "apiVersion": 2 } },
  "entrypoints": [{
    "type": "panel", "id": "layerMath", "label": { "default": "Layer Math" },
    "minimumSize": { "width": 320, "height": 480 },
    "preferredDockedSize": { "width": 380, "height": 680 },
    "preferredFloatingSize": { "width": 420, "height": 720 },
    "icons": [{ "width": 48, "height": 48, "path": "icons/icon.png", "scale": [1], "theme": ["all"], "species": ["generic"] }]
  }],
  "addon": { "name": "layer_math.uxpaddon" },
  "icons": [{ "width": 48, "height": 48, "path": "icons/icon.png", "scale": [1], "theme": ["all"], "species": ["generic"] }],
  "requiredPermissions": { "enableAddon": true, "localFileSystem": "request" }
}
